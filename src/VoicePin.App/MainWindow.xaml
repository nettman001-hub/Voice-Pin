<Window x:Class="VoicePin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다들려 — Voice-Pin" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Color.Bg}"
        FontFamily="{StaticResource Font.Default}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1B1E2B">
            <StackPanel>
                <TextBlock Text="다들려" FontSize="22" FontWeight="Bold" Foreground="White"
                           Margin="20,20,0,2"/>
                <TextBlock x:Name="UserBadge" Text="" FontSize="11.5" Foreground="#9AA1B2"
                           Margin="21,0,0,14"/>

                <RadioButton x:Name="NavLive" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="라이브 청취" Checked="Nav_Checked" Tag="/live"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="음성 학습" Checked="Nav_Checked" Tag="/voice-training"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="인식 단어·규칙" Checked="Nav_Checked" Tag="/recognition-rules"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="판매 내역" Checked="Nav_Checked" Tag="/sales"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="정산·내보내기" Checked="Nav_Checked" Tag="/settlement"/>

                <Separator Background="#2A2F42" Margin="16,10,16,6"/>
                <TextBlock Text="구독 · 계정" FontSize="11" Foreground="#6A7085" Margin="21,0,0,4"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="요금제·구독" Checked="Nav_Checked" Tag="/subscription/plans"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="알림 설정" Checked="Nav_Checked" Tag="/notifications/settings"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="마이페이지" Checked="Nav_Checked" Tag="/my"/>

                <Separator Background="#2A2F42" Margin="16,10,16,6"/>
                <TextBlock Text="관리자 (웹 대시보드 목업)" FontSize="11" Foreground="#6A7085" Margin="21,0,0,4"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="대시보드" Checked="Nav_Checked" Tag="/admin"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="회원 관리" Checked="Nav_Checked" Tag="/admin/members"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="신고 처리" Checked="Nav_Checked" Tag="/admin/reports"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                             Content="통계·오류 로그" Checked="Nav_Checked" Tag="/admin/stats"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Color.Surface}"
                    BorderBrush="{StaticResource Color.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Content="←" FontSize="15" Padding="8,3"
                                Style="{StaticResource BtnSecondary}" Click="Back_Click"/>
                        <TextBlock x:Name="HeaderTitle" Text="라이브 청취" Style="{StaticResource H2}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="HomeBtn" Content="시작 화면" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource BtnSecondary}"
                            Padding="12,5" Click="Home_Click"/>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="PageHost" NavigationUIVisibility="Hidden"
                   Focusable="False"/>

            <Border Grid.Row="2" x:Name="ToastBar" Background="#23283A" CornerRadius="0"
                    Padding="16,9" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
