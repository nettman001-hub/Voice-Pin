<Page x:Class="VoicePin.App.Views.PasswordResetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                    <TextBlock Text="비밀번호 찾기" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                    <TextBlock x:Name="StepTitle" Text="1. 이메일 인증" Style="{StaticResource H2}" Margin="0,0,0,10"/>

                    <TextBlock Text="가입 이메일" Style="{StaticResource Body}" Margin="2,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="EmailBox" Width="240" Style="{StaticResource InputBox}"/>
                        <Button Content="인증 코드 받기" Style="{StaticResource BtnSecondary}"
                                Margin="8,0,0,0" Click="SendCode_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="CodeHint" Style="{StaticResource Muted}" Margin="2,8,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="인증 코드 (6자리)" Style="{StaticResource Body}" Margin="2,14,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CodeBox" Width="130" Style="{StaticResource InputBox}"/>
                        <Button Content="확인" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                Click="Verify_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="NewPwTitle" Text="새 비밀번호" Style="{StaticResource Body}"
                               Margin="2,16,0,5" Visibility="Collapsed"/>
                    <PasswordBox x:Name="NewPwBox" Padding="10,8" Visibility="Collapsed"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"/>

                    <TextBlock x:Name="NewPwConfirmTitle" Text="새 비밀번호 확인" Style="{StaticResource Body}"
                               Margin="2,10,0,5" Visibility="Collapsed"/>
                    <PasswordBox x:Name="NewPwConfirmBox" Padding="10,8" Visibility="Collapsed"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"/>

                    <Button x:Name="ChangeBtn" Content="비밀번호 변경" Style="{StaticResource BtnPrimary}"
                            Margin="0,18,0,0" Visibility="Collapsed" Click="Change_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
