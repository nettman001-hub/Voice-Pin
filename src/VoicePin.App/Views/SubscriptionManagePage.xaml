<Page x:Class="VoicePin.App.Views.SubscriptionManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Margin="0,24">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="현재 구독 정보" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="플랜" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="1" x:Name="PlanText" Style="{StaticResource Body}"/>
                        <TextBlock Grid.Row="1" Text="상태" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusText" Style="{StaticResource Body}"/>
                        <TextBlock Grid.Row="2" Text="만료일" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiryText" Style="{StaticResource Body}"/>
                        <TextBlock Grid.Row="3" Text="다음 결제 예정" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="NextPayText"
                                   Style="{StaticResource Body}"
                                   Text="{Binding ElementName=ExpiryText, Path=Text, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="결제 내역" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Body}" Padding="2,4" Text="2026-08-20　프로 플랜　19,900원　결제 완료"/>
                    <TextBlock Style="{StaticResource Body}" Padding="2,4" Text="2026-07-20　프로 플랜　19,900원　결제 완료"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="요금제 변경" Style="{StaticResource BtnSecondary}"
                        Click="ChangePlan_Click"/>
                <Button Content="구독 해지" Style="{StaticResource BtnDanger}"
                        Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
