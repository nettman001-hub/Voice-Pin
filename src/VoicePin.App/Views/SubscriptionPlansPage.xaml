<Page x:Class="VoicePin.App.Views.SubscriptionPlansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="0,24">
            <TextBlock Text="요금제 선택" Style="{StaticResource H1}"/>
            <TextBlock x:Name="CurrentText" Style="{StaticResource Muted}" Margin="2,6,0,16"/>
            <TextBlock Style="{StaticResource Body}" Margin="2,0,0,12"
                       Text="7일 무료 체험을 제공합니다. 무료 체험 종료 후 선택한 플랜으로 정기 결제됩니다."/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="베이직" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="월 9,900원" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Primary}" Margin="0,8,0,10"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 음성 인식 30시간/월"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 판매 내역 500건"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 캡처 100장"/>
                        <Button Content="이 플랜 선택" Tag="베이직" Style="{StaticResource BtnSecondary}"
                                Margin="0,14,0,0" Click="SelectPlan_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Color.Primary}"
                        BorderThickness="1.5" Margin="8,0,8,8" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="프로 (인기)" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="월 19,900원" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Primary}" Margin="0,8,0,10"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 음성 인식 100시간/월"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 판매 내역 무제한"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 캡처 500장"/>
                        <Button Content="이 플랜 선택" Tag="프로" Style="{StaticResource BtnPrimary}"
                                Margin="0,14,0,0" Click="SelectPlan_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="프리미엄" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="월 29,900원" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Primary}" Margin="0,8,0,10"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 모두 무제한"/>
                        <TextBlock Style="{StaticResource Body}" Text="• 우선 지원"/>
                        <Button Content="이 플랜 선택" Tag="프리미엄" Style="{StaticResource BtnSecondary}"
                                Margin="0,14,0,0" Click="SelectPlan_Click"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Button Content="구독 관리·결제 내역 보기" Style="{StaticResource BtnSecondary}"
                    HorizontalAlignment="Left" MinWidth="200" Margin="2,8,0,20"
                    Click="Manage_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
