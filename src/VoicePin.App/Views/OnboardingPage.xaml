<Page x:Class="VoicePin.App.Views.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="32,28">

            <Border Background="#1B1E2B" CornerRadius="16" Padding="36,34" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="다들려" FontSize="38" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="틱톡 라이브 판매자의 음성을 자동으로 기록하세요"
                               FontSize="17" Foreground="White" Margin="0,10,0,4"/>
                    <TextBlock Text="음성 인식으로 판매 내역을 자동 저장하고 화면 캡처까지"
                               FontSize="13.5" Foreground="#AEB5C6"/>
                </StackPanel>
            </Border>

            <TextBlock Text="주요 기능" Style="{StaticResource H2}" Margin="2,0,0,10"/>
            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,22">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="🎙 실시간 음성 인식" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="방송 중 시스템 소리를 캡처해 Deepgram(Nova-3)으로 실시간 텍스트 변환"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="🧾 판매 내역 자동 저장" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="구매확정 멘트에서 닉네임·금액·시각을 추출해 로컬 DB에 저장"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="📸 화면 캡처" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="'캡처' 같은 트리거 단어가 나오면 지정한 영역을 자동 캡처"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="🎓 나만의 음성 학습" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="자주 쓰는 판매 멘트를 반복 녹음해 인식 단어(keyterm)로 활용"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="이용 안내" Style="{StaticResource H2}" Margin="2,0,0,8"/>
            <TextBlock Style="{StaticResource Body}" Margin="4,0,0,4"
                       Text="• 틱톡 앱(또는 브라우저)을 켜고 방송 중에 다들려 청취를 시작하면 자동으로 인식합니다."/>
            <TextBlock Style="{StaticResource Body}" Margin="4,0,0,20"
                       Text="• 방송 전에 음성 학습과 인식 단어 설정을 하면 인식률이 높아집니다."/>

            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="시작하기" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="로그인" Style="{StaticResource BtnPrimary}" MinWidth="130"
                                Click="Login_Click"/>
                        <Button Content="회원가입" Style="{StaticResource BtnSecondary}" MinWidth="130"
                                Margin="10,0,0,0" Click="Signup_Click"/>
                        <Button Content="요금제 안내" Style="{StaticResource BtnSecondary}" MinWidth="130"
                                Margin="10,0,0,0" Click="Pricing_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,16,0,24">
                <TextBlock Style="{StaticResource Muted}">
                    <Hyperlink Click="FindPassword_Click" Foreground="{StaticResource Color.Muted}">비밀번호 찾기</Hyperlink>
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Text="　|　이용약관　|　개인정보처리방침"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
