<Page x:Class="VoicePin.App.Views.SalesDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:VoicePin.App.Views">
    <Page.Resources>
        <conv:SalesStatusToTextConverter x:Key="StatusText"/>
        <conv:SalesStatusToBrushConverter x:Key="StatusBrush"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="0,24" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="판매 정보" Style="{StaticResource H2}" Margin="0,0,0,12"/>

                    <TextBlock Text="구매자 닉네임" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="NicknameBox" IsReadOnly="True" Style="{StaticResource InputBox}" Margin="1,5,0,10"/>
                    <TextBlock Text="금액 (원)" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="AmountBox" IsReadOnly="True" Style="{StaticResource InputBox}" Margin="1,5,0,10"/>
                    <TextBlock Text="인식 시각" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="RecognizedAtText" Style="{StaticResource Body}" Margin="3,6,0,8"/>
                    <TextBlock Text="방송 회차" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="SessionNoText" Style="{StaticResource Body}" Margin="3,6,0,8"/>
                    <TextBlock Text="상태" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="StatusText2" FontSize="13.5" FontWeight="Bold" Margin="3,6,0,10"/>
                    <TextBlock Text="원본 전사 문장" Style="{StaticResource Muted}"/>
                    <Border Background="{StaticResource Color.Bg}" CornerRadius="8" Padding="12"
                            Margin="1,6,0,0">
                        <TextBlock x:Name="TranscriptText" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="캡처 이미지" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="CapturePanel"/>
                    <TextBlock x:Name="NoCaptureHint" Style="{StaticResource Muted}"
                               Text="캡처 이미지 없음"/>
                </StackPanel>
            </Border>

            <Button x:Name="EditBtn" Content="수정" Style="{StaticResource BtnPrimary}" MinWidth="110"
                    Click="Edit_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" x:Name="EditActions" Visibility="Collapsed">
                <Button Content="저장" Style="{StaticResource BtnPrimary}" MinWidth="90" Click="Save_Click"/>
                <Button Content="취소" Style="{StaticResource BtnSecondary}" MinWidth="80" Margin="8,0,0,0"
                        Click="CancelEdit_Click"/>
            </StackPanel>
            <Button x:Name="DeleteBtn" Content="삭제" Style="{StaticResource BtnDanger}" MinWidth="110"
                    Margin="0,16,0,24" HorizontalAlignment="Left" Click="Delete_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
