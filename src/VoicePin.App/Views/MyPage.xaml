<Page x:Class="VoicePin.App.Views.MyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" Margin="0,24" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="계정 정보" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <TextBlock Text="이메일 (수정 불가)" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="EmailBox" IsReadOnly="True" Style="{StaticResource InputBox}" Margin="1,5,0,12"/>
                    <TextBlock Text="닉네임" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="NicknameBox" Style="{StaticResource InputBox}" Margin="1,5,0,12"/>
                    <TextBlock Text="휴대폰 번호" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource InputBox}" Margin="1,5,0,16"/>
                    <Button Content="저장" Style="{StaticResource BtnPrimary}" MinWidth="100"
                            HorizontalAlignment="Left" Click="Save_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="STT 설정 (Deepgram)" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="KeyStatus" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                    <TextBlock Text="Deepgram API 키" Style="{StaticResource Muted}"/>
                    <PasswordBox x:Name="ApiKeyBox" Padding="10,8" Margin="1,5,0,4"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"
                                 ToolTip="키는 DPAPI로 암호화되어 이 PC에만 저장되며 저장소에 커밋되지 않습니다."/>
                    <CheckBox x:Name="ShowKeyCheck" Content="키 표시" FontSize="12" Margin="2,6,0,0"
                              Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>
                    <TextBox x:Name="ApiKeyPlainBox" Style="{StaticResource InputBox}" Visibility="Collapsed" Margin="1,6,0,0"/>
                    <TextBlock Text="모델 / 언어" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                        <TextBox x:Name="ModelBox" Width="130" Style="{StaticResource InputBox}" Text="nova-3"/>
                        <TextBox x:Name="LangBox" Width="90" Style="{StaticResource InputBox}" Text="ko" Margin="8,0,0,0"/>
                        <Button Content="STT 키·설정 저장" Style="{StaticResource BtnPrimary}"
                                MinWidth="150" Margin="12,0,0,0" Click="SaveKey_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="계정 삭제 요청" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Button Content="계정 삭제 요청" Style="{StaticResource BtnDanger}" MinWidth="140"
                            HorizontalAlignment="Left" Click="DeleteAccount_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
