<Page x:Class="VoicePin.App.Views.AdminMembersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="회원 관리 (목업)" Style="{StaticResource H1}" Margin="0,0,0,14"/>
            <TextBox x:Name="SearchBox" Width="320" HorizontalAlignment="Left"
                     Style="{StaticResource InputBox}" ToolTip="이메일/닉네임 검색" TextChanged="Search_TextChanged"/>
            <ListBox x:Name="MemberList" Margin="0,12,0,0" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Email}" FontSize="12.5"
                                                   Foreground="{StaticResource Color.Muted}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Info}" FontSize="11.5"
                                               Foreground="{StaticResource Color.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                        Background="{Binding StatusBrush}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="ToggleBtn" Content="선택 회원 정지/해제 (데모)" Style="{StaticResource BtnSecondary}"
                    MinWidth="200" HorizontalAlignment="Left" Margin="0,14,0,20" Click="Toggle_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
