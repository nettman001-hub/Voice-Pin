<Page x:Class="VoicePin.App.Views.VoiceTrainingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
            <StackPanel>
                <TextBlock Text="학습 안내" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,4"
                           Text="자주 사용하는 판매 멘트를 녹음하면 인식률이 높아집니다."/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                           Text="같은 문장을 3회 이상 녹음하면 '훈련 완료' 배지가 표시됩니다."/>

                <TextBlock Text="현재 선택한 문장" Style="{StaticResource Body}"/>
                <TextBlock x:Name="CurrentPhraseText" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Color.Primary}"
                           Margin="0,10,0,16" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TrainBtn" Content="🎤 반복 훈련 시작 (3초 후 녹음)"
                            Style="{StaticResource BtnPrimary}" MinWidth="220" Click="Train_Click"/>
                    <Button x:Name="PlayBtn" Content="▶ 마지막 녹음 듣기" Style="{StaticResource BtnSecondary}"
                            Margin="10,0,0,0" Click="Play_Click"/>
                </StackPanel>

                <TextBlock x:Name="RecordStatus" Style="{StaticResource Muted}" Margin="1,12,0,0"
                           Text="문장을 목록에서 선택하거나 위 버튼으로 훈련을 시작하세요."/>

                <Separator Margin="0,18,0,14"/>
                <TextBlock Text="새 문장 추가" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewPhraseBox" Width="280" Style="{StaticResource InputBox}"/>
                    <Button Content="추가" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"
                            Click="AddPhrase_Click"/>
                </StackPanel>

                <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" Margin="1,18,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="학습 목록" Style="{StaticResource H2}"
                           Margin="16,12,16,8"/>
                <ListBox x:Name="PhraseList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="PhraseList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Text}" FontSize="13.5"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ScoreText}" FontSize="11.5"
                                                       Foreground="{Binding ScoreBrush}" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock FontSize="11.5"
                                                       Foreground="{StaticResource Color.Muted}">
                                                <Run Text="녹음 "/><Run Text="{Binding RecordingCount, Mode=OneWay}"/><Run Text="회"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Color.Muted}"
                                                       Margin="12,0,0,0"
                                                       Text="{Binding LastTrainedAt, StringFormat='최근 {0:yyyy-MM-dd}', TargetNullValue='기록 없음'}"/>
                                            <Border Background="#E7F7EF" CornerRadius="5" Padding="7,2"
                                                    Margin="12,0,0,0" Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="훈련 완료" FontSize="11"
                                                           Foreground="#1F7A4D"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="훈련" Tag="{Binding Id}"
                                                Style="{StaticResource BtnSecondary}" Padding="12,5"
                                                Click="QuickTrain_Click"/>
                                        <Button Content="삭제" Tag="{Binding Id}"
                                                Style="{StaticResource BtnDanger}" Padding="9,5" Margin="6,0,0,0"
                                                Click="DeletePhrase_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Page>
