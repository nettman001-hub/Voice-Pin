<Page x:Class="VoicePin.App.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Border x:Name="ErrorBanner" Background="{StaticResource Color.Danger}" CornerRadius="8"
                    Padding="12,9" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="White" FontSize="12.5" TextWrapping="Wrap"/>
            </Border>

            <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                    <TextBlock Text="로그인" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" Text="이메일과 비밀번호로 로그인하세요" Margin="0,0,0,18"/>

                    <TextBlock Text="이메일" Style="{StaticResource Body}" Margin="2,0,0,5"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}"/>
                    <TextBlock Text="비밀번호" Style="{StaticResource Body}" Margin="2,14,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"/>

                    <CheckBox x:Name="AutoLoginCheck" Content="자동 로그인" FontSize="13"
                              Margin="2,14,0,18" IsChecked="True"/>

                    <Button x:Name="LoginBtn" Content="로그인" Style="{StaticResource BtnPrimary}"
                            Click="Login_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Body}">
                            <Hyperlink Click="FindPassword_Click">비밀번호 찾기</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Text="　|　"/>
                        <TextBlock Style="{StaticResource Body}">
                            <Hyperlink Click="Signup_Click">회원가입</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Text="* 데모 빌드: 서버 연동 전이며 모든 계정 정보는 목업입니다."
                               Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
