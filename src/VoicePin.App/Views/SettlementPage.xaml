<Page x:Class="VoicePin.App.Views.SettlementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18" MaxWidth="860" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="PeriodToday" GroupName="period" Content="오늘" FontSize="13"
                             Checked="Period_Changed"/>
                <RadioButton x:Name="PeriodWeek" GroupName="period" Content="이번 주" FontSize="13" Margin="14,0,0,0"/>
                <RadioButton x:Name="PeriodMonth" GroupName="period" Content="이번 달" FontSize="13" Margin="14,0,0,0"/>
                <RadioButton x:Name="PeriodCustom" GroupName="period" Content="직접 지정" FontSize="13" Margin="14,0,0,0"/>
                <TextBox x:Name="FromBox" Width="110" Style="{StaticResource InputBox}" Margin="12,0,0,0"
                         ToolTip="시작일 (yyyy-MM-dd)"/>
                <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ToBox" Width="110" Style="{StaticResource InputBox}"
                         ToolTip="종료일 (yyyy-MM-dd)"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="총 판매 건수" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="CountText" Text="0건" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="총 판매 금액" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="AmountSumText" Text="0원" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Primary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="고유 구매자 수" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="BuyerText" Text="0명" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="보류 건수 (합계 제외)" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="PendingText" Text="0건" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Color.WarnText}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel x:Name="DailyPanel"/>

            <Button Content="⬇ CSV 내보내기 (확정 내역)" Style="{StaticResource BtnPrimary}" MinWidth="220"
                    HorizontalAlignment="Left" Click="Export_Click"/>
            <TextBlock x:Name="EmptyHint" Style="{StaticResource Muted}" Margin="2,10,0,20"
                       Visibility="Collapsed" Text="해당 기간의 판매 내역이 없습니다."/>
        </StackPanel>
    </ScrollViewer>
</Page>
