<Page x:Class="VoicePin.App.Views.AdminStatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="이용 통계 및 시스템 오류 로그 (목업)" Style="{StaticResource H1}" Margin="0,0,0,14"/>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="통계 (일별)" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Body}" Padding="2,4" Text="2026-08-23　가입 3명　판매 내역 저장 156건　인식 성공률 92.4%"/>
                    <TextBlock Style="{StaticResource Body}" Padding="2,4" Text="2026-08-22　가입 5명　판매 내역 저장 203건　인식 성공률 91.8%"/>
                    <TextBlock Style="{StaticResource Body}" Padding="2,4" Text="2026-08-21　가입 1명　판매 내역 저장 88건　　인식 성공률 93.1%"/>
                </StackPanel>
            </Border>

            <Border x:Name="LogCard" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="오류 로그" Style="{StaticResource H2}"/>
                        <ComboBox x:Name="LevelFilter" Width="110" Margin="16,-4,0,0"
                                  VerticalContentAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="전체"/><ComboBoxItem Content="ERROR"/>
                            <ComboBoxItem Content="WARN"/>
                        </ComboBox>
                    </StackPanel>
                    <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                             Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
