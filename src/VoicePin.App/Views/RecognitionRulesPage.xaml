<Page x:Class="VoicePin.App.Views.RecognitionRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
            <StackPanel>
                <TextBlock Text="인식 단어 및 동작 규칙" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap"
                           Text="방송 중 인식할 단어와, 단어가 감지될 때 실행할 동작을 설정하세요. 동작은 'DB 저장'과 '화면 캡처' 중 선택할 수 있습니다. 변경 사항은 다음 청취부터 STT keyterm 바이어싱에 반영됩니다."/>

                <ListBox x:Name="RuleList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Keyword}" FontSize="14.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ActionsText}" FontSize="11.5"
                                                   Foreground="{StaticResource Color.Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="편집" Tag="{Binding Id}" Style="{StaticResource BtnSecondary}"
                                                Padding="10,4" Click="Edit_Click"/>
                                        <Button x:Name="DeleteBtn" Content="삭제" Tag="{Binding Id}"
                                                Style="{StaticResource BtnDanger}" Padding="10,4" Margin="6,0,0,0"
                                                Click="Delete_Click" IsEnabled="{Binding CanDelete}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Separator Margin="0,14,0,12"/>

                <TextBlock Text="단어 추가" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <TextBox x:Name="NewKeywordBox" Style="{StaticResource InputBox}"
                         ToolTip="예: 구매확정, 캡처, 결제 완료"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="ActionSave" GroupName="action" Content="DB 저장" IsChecked="True"
                                 FontSize="13" Margin="2,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ActionCapture" GroupName="action" Content="화면 캡처"
                                 FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ActionBoth" GroupName="action" Content="둘 다"
                                 FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="추가" Style="{StaticResource BtnPrimary}" Padding="18,7"
                            Margin="10,0,0,0" Click="Add_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="1,10,0,0"
                           Text="필수 단어(구매자·닉네임·가격·금액)는 삭제할 수 없고 편집만 가능합니다."/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="캡처 영역 설정" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="'화면 캡처' 동작이 포함된 단어가 감지되면 아래 영역이 자동으로 캡처됩니다."/>

                <RadioButton x:Name="AreaComments" GroupName="area" Content="댓글 목록 (우측 40%)" IsChecked="True"
                             FontSize="13" Margin="2,0,0,8"/>
                <RadioButton x:Name="AreaFull" GroupName="area" Content="화면 전체" FontSize="13" Margin="2,0,0,8"/>
                <RadioButton x:Name="AreaOrders" GroupName="area" Content="주문 내역 (하단 30%)" FontSize="13" Margin="2,0,0,14"/>

                <Border Background="#F1F3F8" CornerRadius="8" Height="120" Margin="0,0,0,12">
                    <Border x:Name="RegionPreview" Background="#25F4EE55" BorderBrush="#25F4EE"
                            BorderThickness="1.5" CornerRadius="4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Width="110" Height="90"/>
                </Border>

                <Button Content="영역 저장" Style="{StaticResource BtnPrimary}" Click="SaveArea_Click"/>
                <TextBlock x:Name="AreaSavedHint" Style="{StaticResource Muted}" Margin="1,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
