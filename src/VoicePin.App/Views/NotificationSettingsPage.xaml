<Page x:Class="VoicePin.App.Views.NotificationSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MaxWidth="640" Margin="0,24" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="이벤트별 알림 채널" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="데모 빌드에서는 토글 값만 저장되며 실제 발송은 서버 연동 후 동작합니다."/>
                    <UniformGrid Columns="3">
                        <TextBlock Text="" />
                        <TextBlock Text="푸시" Style="{StaticResource Body}" FontWeight="Bold"/>
                        <TextBlock Text="이메일" Style="{StaticResource Body}" FontWeight="Bold"/>
                    </UniformGrid>
                    <UniformGrid x:Name="ToggleHost" Columns="3" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="테스트 알림 보내기" Style="{StaticResource BtnSecondary}" MinWidth="170"
                    HorizontalAlignment="Left" Click="Test_Click"/>
        </StackPanel>
    </Grid>
</Page>
