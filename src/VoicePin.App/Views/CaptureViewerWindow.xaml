<Window x:Class="VoicePin.App.Views.CaptureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캡처 이미지" Height="600" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Color.Bg}"
        FontFamily="{StaticResource Font.Default}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="✕ 닫기" Style="{StaticResource BtnSecondary}"
                    Padding="10,5" Click="Close_Click"/>
            <TextBlock Text="캡처 이미지" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="⬇ 다운로드" Style="{StaticResource BtnSecondary}"
                    Padding="10,5" HorizontalAlignment="Right" Click="Download_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#1B1E2B" CornerRadius="12">
            <Grid>
                <Image x:Name="ImageHost" Stretch="Uniform" Margin="14"/>
                <Button x:Name="PrevBtn" Content="‹" Width="40" Height="40" FontSize="22"
                        Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="8,0,0,0" Click="Prev_Click"/>
                <Button x:Name="NextBtn" Content="›" Width="40" Height="40" FontSize="22"
                        Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0" Click="Next_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="IndexText" Text="1 / 1" HorizontalAlignment="Center"
                   Foreground="{StaticResource Color.Muted}" Margin="0,8,0,4"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,10" Margin="0,4,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="구매자 닉네임" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="NicknameText" Style="{StaticResource Body}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="26,0,0,0">
                        <TextBlock Text="판매 금액" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="AmountText" Style="{StaticResource Body}" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Primary}"/>
                    </StackPanel>
                    <StackPanel Margin="26,0,0,0">
                        <TextBlock Text="캡처 시각" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="CapturedAtText" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel Margin="26,0,0,0">
                        <TextBlock Text="캡처 영역" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="AreaText" Style="{StaticResource Body}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="삭제" Style="{StaticResource BtnDanger}" Padding="12,6" Click="Delete_Click"/>
                    <Button Content="공유" Style="{StaticResource BtnSecondary}" Padding="12,6"
                            Margin="8,0,0,0" Click="Share_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
