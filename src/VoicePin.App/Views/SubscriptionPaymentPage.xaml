<Page x:Class="VoicePin.App.Views.SubscriptionPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                    <TextBlock Text="결제 수단 등록·결제" Style="{StaticResource H1}" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource Color.Bg}" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="PlanSummary" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="NextRenewal" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="카드번호" Style="{StaticResource Body}" Margin="2,16,0,5"/>
                    <TextBox x:Name="CardNumberBox" Style="{StaticResource InputBox}"
                             ToolTip="예: 1234-5678-9012-3456"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Width="110" Margin="0,0,10,0">
                            <TextBlock Text="유효기간 (MM/YY)" Style="{StaticResource Body}" Margin="0,0,0,5"/>
                            <TextBox x:Name="ExpiryBox" Style="{StaticResource InputBox}" ToolTip="MM/YY"/>
                        </StackPanel>
                        <StackPanel Width="80" Margin="0,0,10,0">
                            <TextBlock Text="CVC" Style="{StaticResource Body}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="CvcBox" Padding="10,8"
                                         BorderBrush="{StaticResource Color.Border}" Background="White"/>
                        </StackPanel>
                        <StackPanel Width="110">
                            <TextBlock Text="생년월일 6자리" Style="{StaticResource Body}" Margin="0,0,0,5"/>
                            <TextBox x:Name="BirthBox" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="ErrorBanner" Background="#FDECEC" CornerRadius="8" Padding="12,9"
                            Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Foreground="#C03636" FontSize="12.5"
                                   Text="카드 정보가 올바르지 않습니다. 입력값을 확인하고 다시 시도해 주세요."/>
                    </Border>

                    <Button Content="결제" Style="{StaticResource BtnPrimary}" MinWidth="160"
                            Margin="0,18,0,0" Click="Pay_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
