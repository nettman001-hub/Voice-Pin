<Page x:Class="VoicePin.App.Views.LiveHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:VoicePin.App.Views">
    <Page.Resources>
        <conv:SalesStatusToTextConverter x:Key="StatusText"/>
        <conv:SalesStatusToBrushConverter x:Key="StatusBrush"/>
    </Page.Resources>
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#CBD2DC" x:Name="StatusDot"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="대기 중" Style="{StaticResource H2}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource Color.WarnBg}" CornerRadius="6"
                                Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                x:Name="EditBadge" Visibility="Collapsed">
                            <TextBlock Text="수정 대기 중" FontSize="11.5"
                                       Foreground="{StaticResource Color.WarnText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SessionInfo" Style="{StaticResource Muted}" Margin="1,8,0,0"
                               Text="틱톡 라이브를 켠 뒤 [청취 시작]을 누르세요."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙ 인식 규칙 설정" Style="{StaticResource BtnSecondary}"
                            Padding="12,7" Click="OpenRules_Click"/>
                    <Button x:Name="StartStopBtn" Content="● 청취 시작" Style="{StaticResource BtnPrimary}"
                            MinWidth="140" Margin="10,0,0,0" Click="StartStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="실시간 변환 내역" Style="{StaticResource H2}"
                               Margin="16,12,16,8"/>
                    <ListBox x:Name="TranscriptList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemsSource="{Binding Transcripts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Time}" FontSize="11"
                                                       Foreground="{StaticResource Color.Muted}"/>
                                            <TextBlock Text="{Binding Text}" FontSize="13.5"
                                                       Foreground="{StaticResource Color.Ink}"
                                                       Margin="10,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="최근 판매 내역" Style="{StaticResource H2}"
                               Margin="16,12,16,8"/>
                    <ListBox x:Name="RecentSalesList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemsSource="{Binding RecentSales}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nickname}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Color.Ink}"/>
                                            <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}원}" FontSize="14"
                                                       Foreground="{StaticResource Color.Primary}"
                                                       FontWeight="SemiBold" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                       FontSize="11.5"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecognizedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Color.Muted}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Transcript}" FontSize="12"
                                                   Foreground="{StaticResource Color.Muted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}">
                        <Run Text="오늘 판매 "/><Run x:Name="TodayCount" Text="0"/><Run Text="건"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="18,0,0,0">
                        <Run Text="캡처 "/><Run x:Name="TodayCaptures" Text="0"/><Run Text="장"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" Margin="22,0,0,0" VerticalAlignment="Center"
                               Text="방송 중 '수정 시작'이라 말하면 최근 건을 음성으로 수정할 수 있습니다. (예: 닉네임은 홍길동 → 수정 완료)"/>
                </StackPanel>
                <Button Grid.Column="1" Content="판매 내역 보기 →" Style="{StaticResource BtnSecondary}"
                        Padding="12,7" Click="OpenSales_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
