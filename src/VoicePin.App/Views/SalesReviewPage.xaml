<Page x:Class="VoicePin.App.Views.SalesReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:VoicePin.App.Views">
    <Page.Resources>
        <conv:SalesStatusToTextConverter x:Key="StatusText"/>
        <conv:PendingBackgroundConverter x:Key="PendingBg"/>
    </Page.Resources>
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
            <StackPanel x:Name="SessionPanel">
                <TextBlock Text="방송 회차" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                <TextBlock x:Name="SessionInfoText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" x:Name="ReviewList" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,9" Background="{Binding Status, Converter={StaticResource PendingBg}}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nickname}" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}원}" FontSize="14.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Color.Primary}"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding RecognizedAt, StringFormat=HH:mm:ss}"
                                               FontSize="12" Foreground="{StaticResource Color.Muted}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Color.WarnText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding PendingVisible}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Transcript}" FontSize="12"
                                           Foreground="{StaticResource Color.Muted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="수정" Tag="{Binding Id}"
                                    Style="{StaticResource BtnSecondary}" Padding="12,5"
                                    VerticalAlignment="Center" Click="EditOne_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" x:Name="EditPanel" Style="{StaticResource Card}" Padding="16,12"
                Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="수정:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="EditNicknameBox" Width="150" Style="{StaticResource InputBox}" Margin="8,0,0,0"/>
                <TextBox x:Name="EditAmountBox" Width="130" Style="{StaticResource InputBox}" Margin="8,0,0,0"
                         ToolTip="금액 (숫자만)"/>
                <Button Content="저장" Style="{StaticResource BtnPrimary}" Padding="14,7" Margin="10,0,0,0"
                        Click="SaveOne_Click"/>
                <Button Content="취소" Style="{StaticResource BtnSecondary}" Padding="14,7" Margin="6,0,0,0"
                        Click="CancelEdit_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" x:Name="ConfirmBtn" Content="✓ 선택 항목 일괄 확정" Style="{StaticResource BtnPrimary}"
                HorizontalAlignment="Right" MinWidth="180" Margin="0,12,0,0"
                Click="ConfirmAll_Click"/>
    </Grid>
</Page>
