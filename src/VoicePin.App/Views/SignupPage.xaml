<Page x:Class="VoicePin.App.Views.SignupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="480" Margin="0,24">

            <Border x:Name="InfoBanner" Background="#E8F1FF" CornerRadius="8" Padding="12,9"
                    Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="InfoText" FontSize="12.5" TextWrapping="Wrap"/>
            </Border>

            <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                    <TextBlock Text="회원가입" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" Text="판매자 또는 관리자 계정을 만듭니다" Margin="0,0,0,18"/>

                    <TextBlock Text="이메일" Style="{StaticResource Body}" Margin="2,0,0,5"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}"/>

                    <TextBlock Text="역할 선택" Style="{StaticResource Body}" Margin="2,14,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RoleSeller" Content="판매자" IsChecked="True" FontSize="13"
                                     GroupName="role" Margin="2,0,20,0"/>
                        <RadioButton Content="관리자" FontSize="13" GroupName="role"/>
                    </StackPanel>

                    <TextBlock Text="비밀번호 (8자 이상, 영문·숫자·특수문자)" Style="{StaticResource Body}" Margin="2,14,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"/>
                    <TextBlock Text="비밀번호 확인" Style="{StaticResource Body}" Margin="2,10,0,5"/>
                    <PasswordBox x:Name="PasswordConfirmBox" Padding="10,8"
                                 BorderBrush="{StaticResource Color.Border}" Background="White"/>

                    <CheckBox x:Name="TermsCheck" Content="서비스 이용약관 동의 (필수)" FontSize="13" Margin="2,16,0,6"/>
                    <CheckBox x:Name="PrivacyCheck" Content="개인정보 수집·이용 동의 (필수)" FontSize="13" Margin="2,0,0,16"/>

                    <Button x:Name="RequestCodeBtn" Content="이메일 인증 요청" Style="{StaticResource BtnSecondary}"
                            IsEnabled="False" Click="RequestCode_Click"/>

                    <Border x:Name="CodeCard" Visibility="Collapsed" Background="{StaticResource Color.Bg}"
                            CornerRadius="8" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CodeHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="CodeBox" Width="130" Style="{StaticResource InputBox}"/>
                                <Button Content="인증 확인" Style="{StaticResource BtnPrimary}"
                                        Margin="10,0,0,0" Click="Verify_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" Style="{StaticResource Body}">
                        이미 계정이 있으신가요?
                        <Hyperlink Click="LoginLink_Click">로그인</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
