<Page x:Class="VoicePin.App.Views.SalesListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:VoicePin.App.Views">
    <Page.Resources>
        <conv:SalesStatusToTextConverter x:Key="StatusText"/>
        <conv:SalesStatusToBrushConverter x:Key="StatusBrush"/>
    </Page.Resources>
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="300" Style="{StaticResource InputBox}"
                             TextChanged="Search_TextChanged" ToolTip="닉네임·금액·문장 검색"/>
                    <ComboBox x:Name="PeriodCombo" Width="110" Margin="8,0,0,0" SelectionChanged="Filter_Changed"
                              VerticalContentAlignment="Center" SelectedIndex="3">
                        <ComboBoxItem Content="오늘"/><ComboBoxItem Content="7일"/>
                        <ComboBoxItem Content="30일"/><ComboBoxItem Content="전체"/>
                    </ComboBox>
                    <ComboBox x:Name="StatusCombo" Width="100" Margin="6,0,0,0" SelectionChanged="Filter_Changed"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="전체 상태"/><ComboBoxItem Content="자동저장"/>
                        <ComboBoxItem Content="보류"/><ComboBoxItem Content="수동수정"/>
                        <ComboBoxItem Content="확정"/>
                    </ComboBox>
                    <ComboBox x:Name="SortCombo" Width="110" Margin="6,0,0,0" SelectionChanged="Filter_Changed"
                              VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="최신순"/><ComboBoxItem Content="오래된순"/>
                        <ComboBoxItem Content="금액 높은순"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="방송 후 일괄 확인·수정" Style="{StaticResource BtnSecondary}"
                            Padding="12,7" Click="OpenReview_Click"/>
                    <Button Content="정산 내보내기" Style="{StaticResource BtnSecondary}"
                            Padding="12,7" Margin="8,0,0,0" Click="OpenSettlement_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="SalesList" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="Sale_DoubleClick" PreviewMouseLeftButtonUp="Sale_Clicked">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nickname}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}원}" FontSize="15"
                                               FontWeight="Bold" Foreground="{StaticResource Color.Primary}"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                               FontSize="12"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                               FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RecognizedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                           FontSize="11.5" Foreground="{StaticResource Color.Muted}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Transcript}" FontSize="12"
                                           Foreground="{StaticResource Color.Muted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="20"
                                       Foreground="{StaticResource Color.Muted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
