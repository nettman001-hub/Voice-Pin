<Page x:Class="VoicePin.App.Views.AdminReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="신고 처리 (목업)" Style="{StaticResource H1}" Margin="0,0,0,14"/>
            <ListBox x:Name="ReportList" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                               Foreground="{StaticResource Color.Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="처리 완료" Style="{StaticResource BtnSecondary}"
                                        Padding="10,4" VerticalAlignment="Center" Click="Done_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Page>
