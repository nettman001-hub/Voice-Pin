<Page x:Class="VoicePin.App.Views.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="관리자 대시보드 (웹 대시보드 목업)" Style="{StaticResource H1}" Margin="0,0,0,14"/>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="당일 가입자 수" Style="{StaticResource Muted}"/>
                        <TextBlock Text="3명" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="활성 구독자 수" Style="{StaticResource Muted}"/>
                        <TextBlock Text="120명" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Success}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="신고 건수" Style="{StaticResource Muted}"/>
                        <TextBlock Text="5건" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Color.WarnText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="오류 발생 건수" Style="{StaticResource Muted}"/>
                        <TextBlock Text="2건" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Color.Danger}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="18,12">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="회원·신고·통계 관리는 좌측 메뉴에서 목업 화면으로 확인할 수 있습니다. 실제 운영은 별도 웹 대시보드(Chrome 90+, Edge 90+, Safari 14+)로 제공될 예정입니다."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
